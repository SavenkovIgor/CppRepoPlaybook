{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "site: serve",
      "type": "shell",
      "command": "zola serve --interface 0.0.0.0 --port 8080 --base-url 127.0.0.1 --drafts",
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "site: build",
      "type": "shell",
      "command": "zola build",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "site: dev",
      "dependsOn": [
        "site: build",
        "site: serve"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
